# Bootstrap of store DB inside ubuntu-shared postgres
POSTGRES_USER=
POSTGRES_DB=

STORE_DB_USER=store
STORE_DB_PASSWORD=
STORE_DB_NAME=store

# Connection string the backend reads
DATABASE_URL=postgresql+psycopg2://store:PASSWORD@postgres:5432/store

# JWT + cookie
SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# Seeded admin
ADMIN_CUSTOMER_ID=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

# CORS (comma-separated origins, leave empty if all traffic goes through nginx)
CORS_ORIGINS=
